# Copy to .env and fill in. Used by ingestion scripts (batch loader, streaming
# consumer, CDC handler) and dbt (via a matching profiles.yml env var setup).
#
# Either set DATABASE_URL, or the discrete PG* vars below — DATABASE_URL wins
# if both are set.

DATABASE_URL=postgresql://<user>:<password>@localhost:5432/olist_db

PGHOST=localhost
PGPORT=5432
PGDATABASE=olist_db
PGUSER=<user>
PGPASSWORD=<password>
